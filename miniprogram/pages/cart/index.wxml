<view class="page with-bar">
  <view class="empty" wx:if="{{!loading && items.length === 0}}">
    <view class="e-ico">车</view>
    <view>购物车是空的</view>
    <view class="t3" style="margin-top:12rpx">整机和零件可以一起加购，一次结算</view>
    <view class="btn" style="width:320rpx;margin:36rpx auto 0" bindtap="goShop">去逛机型</view>
  </view>

  <view class="card" wx:for="{{items}}" wx:key="id">
    <view class="row">
      <view class="check {{item.selected ? 'on' : ''}}" data-id="{{item.id}}" catchtap="toggle" style="border:none;padding:0;margin-right:12rpx">
        <view class="box">{{item.selected ? '✓' : ''}}</view>
      </view>
      <view class="thumb mini-thumb" data-pid="{{item.productId}}" bindtap="goDetail">图</view>
      <view class="col" style="margin-left:16rpx">
        <view class="t1">{{item.name}}</view>
        <view class="t3">{{item.skuName}}</view>
        <view class="tag grey" style="margin-top:6rpx">{{item.deliveryMethodText}}</view>
        <view class="between" style="margin-top:12rpx">
          <text class="price">¥{{item.priceText}}</text>
          <view class="stepper">
            <text data-id="{{item.id}}" data-step="-1" catchtap="changeQty">－</text>
            <text class="num">{{item.quantity}}</text>
            <text data-id="{{item.id}}" data-step="1" catchtap="changeQty">＋</text>
          </view>
        </view>
      </view>
    </view>
    <view class="between" style="margin-top:12rpx">
      <text class="t3">小计 ¥{{item.lineText}}</text>
      <text class="t3" data-id="{{item.id}}" catchtap="remove">删除</text>
    </view>
  </view>

  <view class="bar" wx:if="{{items.length}}">
    <view class="check {{allSelected ? 'on' : ''}}" bindtap="toggleAll" style="border:none;padding:0;margin-right:8rpx">
      <view class="box">{{allSelected ? '✓' : ''}}</view>
      <text class="t3" style="margin-left:8rpx">全选</text>
    </view>
    <view class="bar-price">
      <view class="t3">已选 {{selectedCount}} 件</view>
      <view class="price price-md"><text class="cny">¥</text>{{totalText}}</view>
    </view>
    <view class="btn" bindtap="checkout">去结算</view>
  </view>
</view>
