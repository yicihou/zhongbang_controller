<view class="page {{needConfirm || canOffline ? 'with-bar' : ''}}">
  <view class="card tint">
    <view class="between">
      <view>
        <view class="t1">报修单 {{w.workNo}}</view>
        <view class="t3" style="margin-top:6rpx">{{w.lines.length || 1}} 台设备 · {{w.expectDate || ''}}</view>
      </view>
      <text class="tag {{w.inWarranty ? '' : 'grey'}}">{{w.inWarranty ? '保内' : '含保外/外购'}}</text>
    </view>
    <view class="t2" style="margin-top:12rpx;color:#96061F">{{w.warrantyDesc}}</view>
    <view class="between" style="margin-top:12rpx"><text class="t2">状态</text><text class="order-st">{{w.statusText}}</text></view>
  </view>

  <view class="card" wx:for="{{w.lines}}" wx:key="id">
    <view class="between">
      <text class="t1">{{item.brand}} {{item.model}}</text>
      <text class="tag grey">{{item.sourceText}}</text>
    </view>
    <view class="t3" style="margin-top:6rpx" wx:if="{{item.sn}}">SN {{item.sn}}</view>
    <view class="t2" style="margin-top:10rpx">{{item.faultText}} · {{item.faultDesc}}</view>
    <view class="t3" style="margin-top:8rpx" wx:if="{{item.purchaseChannel}}">购买渠道：{{item.purchaseChannel}}</view>
    <view class="between" style="margin-top:10rpx" wx:if="{{item.lineQuoteAmount}}">
      <text class="t2">行报价</text><text class="price">¥{{item.quoteText}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{w.quoteAmount > 0}}">
    <view class="between">
      <text class="t1">报价合计</text>
      <text class="price price-md">¥{{w.quoteText}}</text>
    </view>
    <view class="kv" wx:for="{{w.quoteItems}}" wx:key="name">
      <text>{{item.name}}</text><text>¥{{item.amountText}}</text>
    </view>
    <view class="t3" style="margin-top:8rpx">维修费一期线下转账，请联系管理员</view>
  </view>

  <view class="card" wx:if="{{w.payments.length}}">
    <view class="t1" style="margin-bottom:12rpx">待付款 / 付款记录</view>
    <view class="between" wx:for="{{w.payments}}" wx:key="id" style="padding:10rpx 0">
      <text class="t2">{{item.typeText}} · {{item.statusText}}</text>
      <text class="price">¥{{item.amountText}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{contact && (needConfirm || canOffline)}}">
    <view class="t1" style="margin-bottom:12rpx">管理员联系方式</view>
    <view class="between">
      <text class="t2">微信 {{contact.wechat}}</text>
      <text class="btn mini ghost" bindtap="copyWechat">复制</text>
    </view>
    <view class="between" style="margin-top:12rpx">
      <text class="t2">电话 {{contact.phone}}</text>
      <text class="btn mini ghost" bindtap="callAdmin">拨打</text>
    </view>
  </view>

  <view class="card">
    <view class="t1" style="margin-bottom:16rpx">进度</view>
    <view class="timeline">
      <view class="tl {{item.done ? 'on' : ''}}" wx:for="{{w.timeline}}" wx:key="status">
        <view class="tl-dot"></view>
        <view class="tl-body">
          <view class="tl-t">{{item.title}}</view>
          <view class="t3" wx:if="{{item.desc}}">{{item.desc}}</view>
          <view class="t3" wx:if="{{item.time}}">{{item.time}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="btn ghost block" wx:if="{{w.status === 'DONE'}}" bindtap="goEvaluate">评价这次维修</view>

  <view class="bar" wx:if="{{needConfirm || canOffline}}">
    <view class="btn" wx:if="{{needConfirm}}" style="flex:1" bindtap="goQuote">确认报价</view>
    <view class="btn" wx:if="{{canOffline}}" style="flex:1" bindtap="offlineIntent">
      {{intenting ? '提交中…' : '我将线下转账'}}
    </view>
  </view>
</view>
