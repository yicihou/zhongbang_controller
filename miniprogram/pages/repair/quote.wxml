<view class="page with-bar">
  <view class="card tint">
    <view class="t1">{{w.assetModel || '维修报价'}}</view>
    <view class="t2" style="margin-top:8rpx;color:#96061F">{{w.warrantyDesc}}</view>
    <view class="t3" wx:if="{{must}}" style="margin-top:8rpx">金额超过 300 元，未确认不能进入维修。</view>
  </view>

  <view class="card">
    <view class="t1" style="margin-bottom:8rpx">费用明细</view>
    <view class="kv" wx:for="{{items}}" wx:key="name">
      <text>{{item.name}}</text>
      <text class="price">¥{{item.amountText}}</text>
    </view>
    <view class="empty" wx:if="{{items.length === 0}}">报价金额已生成，明细待师傅补充</view>
    <view class="between" style="margin-top:16rpx">
      <text class="t1">合计</text>
      <price cents="{{w.quoteAmount}}" size="lg" />
    </view>
  </view>

  <view class="card">
    <view class="t1">备注</view>
    <textarea class="ta" placeholder="同意可留空；拒绝请写原因，例如先不修了" value="{{remark}}" bindinput="onRemark" />
  </view>

  <view class="bar">
    <view class="btn ghost" style="flex:1" data-accept="0" bindtap="decide">拒绝</view>
    <view class="btn" style="flex:1" data-accept="1" bindtap="decide">确认报价</view>
  </view>
</view>
