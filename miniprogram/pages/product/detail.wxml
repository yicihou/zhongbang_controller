<view class="page with-bar" style="padding-top:0">
  <view class="thumb" style="height:460rpx;border-radius:0">主图 / 视频</view>

  <view class="card" style="margin-top:-30rpx;position:relative;z-index:2">
    <view class="t1" style="font-size:34rpx">{{p.name}}</view>
    <view class="t2" style="margin-top:8rpx">{{p.subtitle}}</view>
    <view class="between" style="margin-top:18rpx">
      <view>
        <text class="price price-lg"><text class="cny">¥</text>{{priceText}}</text>
        <text class="t3" style="margin-left:12rpx">库存 {{activeSku.stock}}</text>
      </view>
      <text class="tag grey">{{p.model}}</text>
    </view>
    <view class="row" style="flex-wrap:wrap;margin-top:16rpx">
      <text class="tag" wx:for="{{p.services}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="card">
    <view class="between">
      <text class="t1">选择配置</text>
      <text class="t2">已选：{{activeSku.name || '请选择'}}</text>
    </view>
    <block wx:if="{{groups.length}}">
      <view wx:for="{{groups}}" wx:for-item="g" wx:key="name" style="margin-top:16rpx">
        <view class="t3">{{g.name}}</view>
        <view class="sku" style="display:flex;flex-wrap:wrap;width:auto;padding:0;border:none;background:transparent">
          <text class="cat {{opt.on ? 'on' : ''}} {{opt.out ? 'out' : ''}}"
                wx:for="{{g.options}}" wx:for-item="opt" wx:key="value"
                data-dim="{{g.name}}" data-value="{{opt.value}}" bindtap="onOpt">{{opt.label}}</text>
        </view>
      </view>
    </block>
    <view class="sku-list" wx:else>
      <view class="sku {{activeSku.id === item.id ? 'on' : ''}} {{item.stock === 0 ? 'out' : ''}}"
            wx:for="{{p.skus}}" wx:key="id" data-id="{{item.id}}" bindtap="onSku">
        <view class="sku-n">{{item.name}}</view>
        <view class="sku-p">
          <text wx:if="{{item.stock > 0}}">¥{{item.priceText}}</text>
          <text wx:else>暂时缺货</text>
        </view>
      </view>
    </view>
    <view class="field" style="margin-top:8rpx">
      <text class="field-k">数量</text>
      <view class="stepper">
        <text data-step="-1" catchtap="changeQty">－</text>
        <text class="num">{{quantity}}</text>
        <text data-step="1" catchtap="changeQty">＋</text>
      </view>
    </view>
    <view class="t3" style="margin-top:8rpx" wx:if="{{activeSku.stock === 0}}" bindtap="notify">该配置缺货，点此登记到货通知</view>
  </view>

  <view class="card">
    <view class="t1" style="margin-bottom:8rpx">付款说明</view>
    <view class="t2">一期线下转账：提交订单后按标价生成待付款，管理员可改价/拆定金尾款。安装费待管理员确认，运费默认 0。</view>
  </view>

  <view class="card">
    <view class="t1" style="margin-bottom:8rpx">核心参数</view>
    <view class="field" wx:for="{{p.specs}}" wx:key="name">
      <text class="t2">{{item.name}}</text>
      <text class="field-v">{{item.value}}</text>
    </view>
  </view>

  <view class="card">
    <view class="t1" style="margin-bottom:8rpx">保修与保障</view>
    <view class="t2">{{p.warranty.desc}}</view>
    <view class="divider"></view>
    <view class="t2" wx:for="{{p.services}}" wx:key="*this">· {{item}}</view>
  </view>

  <view class="bar">
    <view class="bar-price" bindtap="goCart">
      <view class="t3">购物车</view>
      <view class="t1">去看看</view>
    </view>
    <view class="btn ghost" style="width:200rpx;flex:none" bindtap="addCart">{{adding ? '…' : '加入购物车'}}</view>
    <view class="btn" style="width:220rpx;flex:none" bindtap="buyNow">{{activeSku.stock === 0 ? '到货通知' : '立即购买'}}</view>
  </view>
</view>
