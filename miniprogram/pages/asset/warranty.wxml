<view class="page">
  <view class="card" style="background:linear-gradient(135deg,#C8102E,#96061F);color:#fff">
    <view class="t3" style="color:rgba(255,255,255,.8)">电子保修卡</view>
    <view class="t1" style="font-size:36rpx;margin-top:10rpx;color:#fff">{{a.model}}</view>
    <view style="margin-top:18rpx;font-size:30rpx;letter-spacing:1rpx">{{a.sn}}</view>
    <view class="tag" style="margin-top:18rpx;background:#fff;color:#C8102E">{{a.warrantyText || '保修状态待确认'}}</view>
  </view>

  <view class="card">
    <view class="kv"><text>购机日期</text><text>{{a.buyDate || '—'}}</text></view>
    <view class="kv"><text>保修截止</text><text>{{a.warrantyEnd || '—'}}</text></view>
    <view class="kv"><text>最近服务</text><text>{{a.lastServiceAt || '暂无'}}</text></view>
    <view class="kv"><text>状态</text><text>{{a.warrantyStatus === 'IN' ? '保内' : (a.warrantyStatus === 'OUT' ? '已过保' : '未知')}}</text></view>
  </view>

  <view class="card">
    <view class="t1">保修说明</view>
    <view class="t2" style="margin-top:10rpx">以安装完成日（没有安装则以签收日）起算。整机 12 个月，电机与电控 24 个月，具体以该机型政策为准。</view>
    <view class="t2">人为损坏、私自拆机不在保修范围内。保外维修先检测报价，超过 300 元需您线上确认。</view>
  </view>

  <view class="btn block" bindtap="repair">这台机器报修</view>
</view>
