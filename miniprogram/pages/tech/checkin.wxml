<view class="page">
  <view class="card">
    <view class="t1">{{w.customerName || '客户'}}</view>
    <view class="t2" style="margin-top:8rpx">{{w.address}}</view>
    <view class="t3" style="margin-top:8rpx">需在客户地址 500 米以内。超过会返回错误码 3005。</view>
  </view>
  <view class="btn block" bindtap="usePhone">使用当前定位打卡</view>
  <view class="btn ghost block" style="margin-top:20rpx" bindtap="useNear">模拟到场（约 10 米）</view>
  <view class="btn grey block" style="margin-top:20rpx" bindtap="useFar">模拟距离过远</view>
  <view class="t3 center" style="margin-top:20rpx">开发者工具经常没有真实定位，演示请用「模拟到场」</view>
</view>
