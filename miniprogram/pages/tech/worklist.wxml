<view class="page">
  <view class="between" style="margin:0 4rpx 16rpx">
    <text class="t1">工单</text>
    <text class="tag">{{list.length}} 单</text>
  </view>

  <scroll-view scroll-x class="tabs">
    <view class="tab {{status === item.value ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="value"
          data-value="{{item.value}}" bindtap="onTab">{{item.label}}</view>
  </scroll-view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    <view class="e-ico">□</view>
    <view>这个状态下没有工单</view>
  </view>

  <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
    <view class="order-h">
      <text>{{item.workNo}}</text>
      <text class="order-st">{{item.statusText}}</text>
    </view>
    <view class="t1">{{item.typeText}} · {{item.faultText}}</view>
    <view class="t3" style="margin-top:6rpx">{{item.customerName}} · {{item.address}}</view>
    <view class="row" style="margin-top:12rpx">
      <text class="tag {{item.inWarranty ? '' : 'grey'}}">{{item.inWarranty ? '保内' : '保外'}}</text>
      <text class="t3" style="margin-left:16rpx">{{item.appointmentAt || '待预约'}} · {{item.distanceKm}} km</text>
    </view>
    <view class="between" style="margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #F1F3F6">
      <text class="t3">点进详情处理</text>
      <text class="btn mini" wx:if="{{item.status === 'PENDING'}}" data-id="{{item.id}}" catchtap="accept">接单</text>
      <text class="btn mini ghost" wx:else>查看</text>
    </view>
  </view>
</view>
