<view class="page">
  <view class="between" style="margin:0 4rpx 16rpx">
    <text class="t1">师傅工作台</text>
    <text class="tag">今日 {{list.length}} 单</text>
  </view>

  <scroll-view scroll-x class="tabs">
    <view class="tab {{status === '' ? 'on' : ''}}" data-value="" bindtap="onTab">全部</view>
    <view class="tab {{status === 'PENDING' ? 'on' : ''}}" data-value="PENDING" bindtap="onTab">待接单</view>
    <view class="tab {{status === 'ACCEPTED' ? 'on' : ''}}" data-value="ACCEPTED" bindtap="onTab">进行中</view>
  </scroll-view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    <view class="e-ico">□</view>
    <view>暂时没有工单</view>
  </view>

  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="order-h">
      <text>{{item.workNo}}</text>
      <text class="order-st">{{item.statusText}}</text>
    </view>
    <view class="t1">{{item.faultText}} · {{item.customerName}}</view>
    <view class="t3" style="margin-top:6rpx">{{item.address}} · {{item.distanceKm}} km</view>
    <view class="row" style="margin-top:12rpx">
      <text class="tag {{item.inWarranty ? '' : 'grey'}}">{{item.inWarranty ? '保内' : '保外'}}</text>
      <text class="t3" style="margin-left:16rpx">{{item.appointmentAt || '待预约'}}</text>
    </view>
    <view class="between" style="margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #F1F3F6">
      <text class="t3">{{item.typeText}}工单</text>
      <text class="btn mini" wx:if="{{item.status === 'PENDING'}}"
            data-id="{{item.id}}" catchtap="accept">接单</text>
      <text class="t3" wx:else>已接单</text>
    </view>
  </view>
</view>
