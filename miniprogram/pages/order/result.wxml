<view class="page">
  <view class="card" style="text-align:center;padding:48rpx 28rpx">
    <view class="avatar" style="margin:0 auto 20rpx;background:#C8102E;color:#fff;width:96rpx;height:96rpx">付</view>
    <view class="t1" style="font-size:36rpx">{{typeText}}支付成功</view>
    <view class="t2" style="margin-top:10rpx">{{loading ? '正在核对订单…' : nextText}}</view>
    <view style="margin-top:28rpx">
      <price cents="{{amountCents}}" size="lg" />
    </view>
    <view class="t3" style="margin-top:12rpx">单号 {{orderNo}}</view>
  </view>

  <view class="card tint">
    <view class="t2" style="color:#96061F">前端展示的“支付成功”只用于跳转。订单状态以服务端收到的微信支付回调为准，丢单会由查单任务补偿。</view>
  </view>

  <view class="btn block" bindtap="goDetail">查看订单</view>
  <view class="btn ghost block" style="margin-top:20rpx" bindtap="subscribe">开启进度提醒</view>
  <view class="btn grey block" style="margin-top:20rpx" bindtap="goHome">返回首页</view>
</view>
