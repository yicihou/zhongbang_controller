<view class="page with-bar" style="padding:0">
  <view class="status-hero">
    <view class="st">{{o.statusText}}</view>
    <view class="sd">{{statusDesc}}</view>
  </view>

  <view style="padding:24rpx 24rpx 0">
    <view class="card">
      <view class="t1" style="margin-bottom:12rpx">收货与安装</view>
      <view class="t2">{{o.address.name}} {{o.address.mobile}}</view>
      <view class="t2" style="margin-top:6rpx">{{o.address.province}}{{o.address.city}}{{o.address.district}}{{o.address.detail}}</view>
      <view class="divider"></view>
      <view class="between"><text class="t2">期望安装</text><text>{{o.installDate}} {{slotText}}</text></view>
      <view class="between" style="margin-top:10rpx" wx:if="{{o.remark}}">
        <text class="t2">备注</text><text class="t2" style="max-width:70%">{{o.remark}}</text>
      </view>
    </view>

    <view class="card">
      <view class="order-h"><text>订单号 {{o.orderNo}}</text></view>
      <view class="order-item" wx:for="{{o.items}}" wx:for-item="it" wx:key="skuId">
        <view class="thumb mini-thumb">图</view>
        <view class="col" style="margin-left:16rpx">
          <view class="t1">{{it.name}}</view>
          <view class="t3">{{it.skuName}}</view>
        </view>
        <view style="text-align:right">
          <view class="price">¥{{it.priceText}}</view>
          <view class="t3">x{{it.quantity}}</view>
        </view>
      </view>
      <view class="divider"></view>
      <view class="between"><text class="t2">订单总额</text><text>¥{{o.totalText}}</text></view>
      <view class="between" style="margin-top:12rpx"><text class="t2">已付</text><text class="price">¥{{o.paidText}}</text></view>
      <view class="between" style="margin-top:12rpx">
        <text class="t2">待付</text><text class="price price-md">¥{{o.balanceText}}</text>
      </view>
      <view class="tint-box" wx:if="{{offlineHint}}">请联系商家线下付款。安装费未定时，门店确认后才会算进应付。</view>
    </view>

    <view class="card" wx:if="{{o.technician}}">
      <view class="t1" style="margin-bottom:16rpx">安装师傅</view>
      <view class="row">
        <view class="avatar">{{techInitial}}</view>
        <view class="col" style="margin-left:18rpx">
          <view class="t1">{{o.technician.name}}</view>
          <view class="t3">★ {{o.technician.rating}} · {{o.technician.mobile}}</view>
        </view>
        <text class="btn mini ghost" catchtap="callTech">联系</text>
      </view>
    </view>

    <view class="card">
      <view class="t1" style="margin-bottom:16rpx">订单进度</view>
      <view class="timeline">
        <view class="tl {{item.done ? 'on' : ''}}" wx:for="{{o.timeline}}" wx:key="status">
          <view class="tl-dot"></view>
          <view class="tl-body">
            <view class="tl-t">{{item.title}}</view>
            <view class="t3" wx:if="{{item.desc}}">{{item.desc}}</view>
            <view class="t3" wx:if="{{item.time}}">{{item.time}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bar" wx:if="{{hasAction}}">
    <view class="btn ghost" wx:if="{{canCancel}}" bindtap="cancel" style="flex:1">取消订单</view>
    <view class="btn ghost" wx:if="{{canCall}}" bindtap="callTech" style="flex:1">联系师傅</view>
    <view class="btn" wx:if="{{canAccept}}" bindtap="accept" style="flex:1">确认验收</view>
    <view class="btn" wx:if="{{payType}}" bindtap="pay" style="flex:1">{{payText}}</view>
    <view class="btn" wx:if="{{canRepair}}" bindtap="goRepair" style="flex:1">申请报修</view>
  </view>
</view>
